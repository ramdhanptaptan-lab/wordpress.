{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1320px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "customDuotone": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "noir",
          "color": "#0A0908",
          "name": "Noir"
        },
        {
          "slug": "soot",
          "color": "#12100E",
          "name": "Soot"
        },
        {
          "slug": "slate",
          "color": "#1B1815",
          "name": "Slate"
        },
        {
          "slug": "slate-2",
          "color": "#221E1A",
          "name": "Slate Deep"
        },
        {
          "slug": "bone",
          "color": "#EFE9DE",
          "name": "Bone"
        },
        {
          "slug": "bone-dim",
          "color": "#C9C1B5",
          "name": "Bone Dim"
        },
        {
          "slug": "ash",
          "color": "#9C948A",
          "name": "Ash"
        },
        {
          "slug": "ash-dim",
          "color": "#6E675F",
          "name": "Ash Dim"
        },
        {
          "slug": "tungsten",
          "color": "#D9A441",
          "name": "Tungsten"
        },
        {
          "slug": "tungsten-deep",
          "color": "#A9762A",
          "name": "Tungsten Deep"
        },
        {
          "slug": "daylight",
          "color": "#6E93A6",
          "name": "Daylight"
        },
        {
          "slug": "line",
          "color": "rgba(239,233,222,0.12)",
          "name": "Line"
        },
        {
          "slug": "line-soft",
          "color": "rgba(239,233,222,0.07)",
          "name": "Line Soft"
        }
      ],
      "gradients": [
        {
          "slug": "stage-veil",
          "name": "Stage Veil",
          "gradient": "linear-gradient(to top, rgba(10,9,8,0.9) 0%, rgba(10,9,8,0.34) 34%, rgba(10,9,8,0.04) 62%, rgba(10,9,8,0.5) 100%)"
        },
        {
          "slug": "banner-veil",
          "name": "Banner Veil",
          "gradient": "linear-gradient(to bottom, rgba(10,9,8,0.72) 0%, rgba(10,9,8,0.42) 42%, rgba(10,9,8,0.86) 100%)"
        },
        {
          "slug": "ember-wash",
          "name": "Ember Wash",
          "gradient": "linear-gradient(180deg, rgba(217,164,65,0.05) 0%, rgba(10,9,8,0) 70%)"
        },
        {
          "slug": "soot-wash",
          "name": "Soot Wash",
          "gradient": "linear-gradient(180deg, #12100E 0%, #0A0908 100%)"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": true,
      "customLineHeight": true,
      "dropCap": false,
      "lineHeight": true,
      "fontWeight": true,
      "textTransform": true,
      "letterSpacing": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "fontFamily": "Archivo, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "slug": "archivo",
          "name": "Archivo",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Archivo-Variable.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"Bodoni Moda\", Georgia, \"Times New Roman\", serif",
          "slug": "bodoni-moda",
          "name": "Bodoni Moda",
          "fontFace": [
            {
              "fontFamily": "Bodoni Moda",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BodoniModa-Variable.woff2"
              ]
            },
            {
              "fontFamily": "Bodoni Moda",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BodoniModa-Italic-Variable.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"DM Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
          "slug": "dm-mono",
          "name": "DM Mono",
          "fontFace": [
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMMono-Regular.woff2"
              ]
            },
            {
              "fontFamily": "DM Mono",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMMono-Medium.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(46px, 7.1vw, 116px)"
        },
        {
          "slug": "h1",
          "name": "H1",
          "size": "clamp(34px, 4.05vw, 66px)"
        },
        {
          "slug": "h2",
          "name": "H2",
          "size": "clamp(30px, 3.5vw, 56px)"
        },
        {
          "slug": "h3",
          "name": "H3",
          "size": "clamp(20px, 1.6vw, 27px)"
        },
        {
          "slug": "h4",
          "name": "H4",
          "size": "18px"
        },
        {
          "slug": "h5",
          "name": "H5",
          "size": "16px"
        },
        {
          "slug": "h6",
          "name": "H6",
          "size": "14.5px"
        },
        {
          "slug": "marker",
          "name": "Marker",
          "size": "clamp(19px, 1.5vw, 24px)"
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "clamp(16px, 1.15vw, 19px)"
        },
        {
          "slug": "paragraph",
          "name": "Paragraph",
          "size": "16px"
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "14.5px"
        },
        {
          "slug": "x-small",
          "name": "Extra Small",
          "size": "13px"
        },
        {
          "slug": "label",
          "name": "Mono Label",
          "size": "12.5px"
        },
        {
          "slug": "label-xs",
          "name": "Mono Label XS",
          "size": "11.5px"
        },
        {
          "slug": "button",
          "name": "Button",
          "size": "14.5px"
        },
        {
          "slug": "stat",
          "name": "Stat",
          "size": "clamp(34px, 3.8vw, 58px)"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "1",
          "size": "8px"
        },
        {
          "slug": "30",
          "name": "2",
          "size": "16px"
        },
        {
          "slug": "40",
          "name": "3",
          "size": "26px"
        },
        {
          "slug": "50",
          "name": "4",
          "size": "clamp(28px, 2.6vw, 40px)"
        },
        {
          "slug": "60",
          "name": "5",
          "size": "clamp(38px, 3.8vw, 58px)"
        },
        {
          "slug": "70",
          "name": "6",
          "size": "clamp(48px, 5vw, 84px)"
        },
        {
          "slug": "80",
          "name": "7",
          "size": "clamp(72px, 7.6vw, 146px)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 12px 34px rgba(0,0,0,.42)"
        },
        {
          "slug": "deep",
          "name": "Deep",
          "shadow": "0 26px 70px rgba(0,0,0,.55)"
        }
      ]
    },
    "dimensions": {
      "minHeight": true,
      "aspectRatio": true
    },
    "position": {
      "sticky": true
    },
    "custom": {
      "radius": {
        "sm": "12px",
        "md": "18px",
        "lg": "26px",
        "pill": "999px"
      },
      "ease": "cubic-bezier(.22,.61,.36,1)"
    },
    "core/navigation": {
      "spacing": {
        "margin": true,
        "padding": true
      }
    }
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--bone)",
      "background": "var(--wp--preset--color--noir)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--archivo)",
      "fontSize": "16px",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "26px"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--bone)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "600",
          "lineHeight": "1.06",
          "letterSpacing": "-0.028em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h1)",
          "lineHeight": "1.02",
          "letterSpacing": "-0.033em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h2)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h3)",
          "lineHeight": "1.2",
          "letterSpacing": "-0.02em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h4)",
          "lineHeight": "1.3",
          "letterSpacing": "-0.012em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h5)",
          "lineHeight": "1.35",
          "letterSpacing": "-0.01em"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h6)",
          "lineHeight": "1.4",
          "letterSpacing": "0"
        }
      },
      "link": {
        "color": {
          "text": "currentColor"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--tungsten)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--ash)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "var(--wp--preset--font-size--button)",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "-0.005em",
          "textTransform": "none"
        },
        "color": {
          "background": "var(--wp--preset--color--bone)",
          "text": "var(--wp--preset--color--noir)"
        },
        "border": {
          "radius": "999px",
          "width": "1px",
          "style": "solid",
          "color": "transparent"
        },
        "spacing": {
          "padding": {
            "top": "15px",
            "bottom": "15px",
            "left": "26px",
            "right": "26px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--tungsten)",
            "text": "#1A1207"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "color": {
          "text": "var(--wp--preset--color--bone-dim)"
        }
      },
      "core/list": {
        "color": {
          "text": "var(--wp--preset--color--bone-dim)"
        }
      },
      "core/cover": {
        "spacing": {
          "margin": {
            "top": "0px"
          }
        }
      },
      "core/template-part": {
        "spacing": {
          "margin": {
            "top": "0"
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--line)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "19.5px",
          "fontWeight": "700",
          "letterSpacing": "0.16em"
        },
        "color": {
          "text": "var(--wp--preset--color--bone)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "600",
          "letterSpacing": "-0.018em",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var(--wp--preset--color--bone)"
        }
      },
      "core/query-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "600",
          "letterSpacing": "-0.028em"
        },
        "color": {
          "text": "var(--wp--preset--color--bone)"
        }
      },
      "core/navigation-link": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "13px",
          "fontWeight": "500",
          "textTransform": "uppercase",
          "letterSpacing": "0.1em"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-mono)",
          "fontSize": "var(--wp--preset--font-size--label-xs)",
          "textTransform": "uppercase",
          "letterSpacing": "0.05em"
        },
        "color": {
          "text": "var(--wp--preset--color--tungsten)"
        }
      },
      "core/post-date": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "var(--wp--preset--font-size--label)",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--ash)"
        }
      },
      "core/post-author-name": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--label)"
        },
        "color": {
          "text": "var(--wp--preset--color--ash)"
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var(--wp--preset--color--ash)"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bodoni-moda)",
          "fontStyle": "italic",
          "fontSize": "clamp(21px, 2.35vw, 32px)",
          "lineHeight": "1.34",
          "letterSpacing": "-0.012em"
        },
        "color": {
          "text": "var(--wp--preset--color--bone)"
        },
        "border": {
          "left": {
            "color": "var(--wp--preset--color--tungsten)",
            "width": "1px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "clamp(20px, 2.2vw, 34px)",
            "right": "0",
            "top": "6px",
            "bottom": "6px"
          }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bodoni-moda)",
          "fontStyle": "italic"
        },
        "color": {
          "text": "var(--wp--preset--color--bone)"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-mono)",
          "fontSize": "13.5px"
        },
        "color": {
          "background": "var(--wp--preset--color--soot)",
          "text": "var(--wp--preset--color--bone-dim)"
        },
        "border": {
          "radius": "12px",
          "color": "var(--wp--preset--color--line)",
          "width": "1px",
          "style": "solid"
        },
        "spacing": {
          "padding": {
            "top": "20px",
            "bottom": "20px",
            "left": "22px",
            "right": "22px"
          }
        }
      },
      "core/preformatted": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-mono)",
          "fontSize": "13.5px"
        },
        "color": {
          "background": "var(--wp--preset--color--soot)",
          "text": "var(--wp--preset--color--bone-dim)"
        }
      },
      "core/table": {
        "color": {
          "text": "var(--wp--preset--color--bone-dim)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
